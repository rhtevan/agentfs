# topology.env — Skupper VAN site-specific topology
# Copy this file to topology.env and fill in your values.
# topology.env is gitignored — it never leaves your machine.
#
# ┌─────────────────── Skupper VAN Topology ───────────────────┐
# │                                                            │
# │  ┌──────────────┐    AMQPS     ┌──────────────────────┐   │
# │  │ hub-alpha     │◄────────────►│                      │   │
# │  │ (interior)    │  port 8000   │   local-myhost       │   │
# │  │ alpha.example │              │   (interior/outbound)│   │
# │  │ .com          │              │   localhost           │   │
# │  │ Models: g8b,  │              │   Listeners:          │   │
# │  │   g30b, g8b…  │              │     :9000 → alpha    │   │
# │  └──────────────┘              │     :10000→ beta     │   │
# │                                │                      │   │
# │  ┌──────────────┐    AMQPS     │                      │   │
# │  │ hub-beta      │◄────────────►│                      │   │
# │  │ (interior)    │  port 55671  └──────────────────────┘   │
# │  │ 10.0.1.50     │                                         │
# │  │ Models: g350m │                                         │
# │  │   g1b, g8b    │                                         │
# │  └──────────────┘                                         │
# │                                                            │
# │  PUBLIC_HOST — routable address the local router uses to   │
# │    connect to each remote hub via AMQPS.                   │
# │  SANS — TLS certificate Subject Alternative Names. Must    │
# │    include every hostname/IP a client could use to reach   │
# │    the hub, or TLS handshake fails with name mismatch.     │
# └────────────────────────────────────────────────────────────┘

# ── Local Site ────────────────────────────────────────────────
# Name for this machine's Skupper site (must be unique in the VAN)
LOCAL_SITE_NAME="local-myhost"

# ── Remote Hub: rhel-ai ──────────────────────────────────────
# SSH alias used to reach this host (must match ~/.ssh/config)
RHEL_AI_SSH_HOST="rhel-ai"
# Inter-router port (publicly accessible for remote links)
RHEL_AI_INTER_ROUTER_PORT=8000
# Edge port for edge-mode connections
RHEL_AI_EDGE_PORT=45671
# Skupper routing key (matches Connector/Listener pairing)
RHEL_AI_ROUTING_KEY="model-api-rhel-ai"
# Local listener port (localhost:<port> → remote model)
RHEL_AI_MODEL_PORT=9000
# Routable hostname or IP the local site connects to
RHEL_AI_PUBLIC_HOST="alpha.example.com"
# TLS SANs — comma-separated, must include PUBLIC_HOST
RHEL_AI_SANS="alpha.internal,alpha.example.com,10.0.0.1,203.0.113.1"

# ── Remote Hub: rhtevan-work ─────────────────────────────────
# SSH alias used to reach this host (must match ~/.ssh/config)
RHTEVAN_WORK_SSH_HOST="rhtevan-work"
# Inter-router port
RHTEVAN_WORK_INTER_ROUTER_PORT=55671
# Edge port
RHTEVAN_WORK_EDGE_PORT=45671
# Skupper routing key
RHTEVAN_WORK_ROUTING_KEY="model-api-rhtevan-work"
# Local listener port
RHTEVAN_WORK_MODEL_PORT=10000
# Routable hostname or IP
RHTEVAN_WORK_PUBLIC_HOST="10.0.1.50"
# TLS SANs — comma-separated, must include PUBLIC_HOST
RHTEVAN_WORK_SANS="beta-internal,10.0.1.50"
