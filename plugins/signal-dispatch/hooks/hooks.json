{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "^[Hh]ey ",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/detect-hey.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/enforce-hey.sh",
            "on_failure": "allow"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/cleanup-stale.sh"
          }
        ]
      }
    ]
  }
}
