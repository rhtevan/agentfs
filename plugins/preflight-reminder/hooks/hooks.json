{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "${PLUGIN_ROOT}/scripts/arm.sh" } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "${PLUGIN_ROOT}/scripts/enforce-preflight.sh", "on_failure": "allow" } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "${PLUGIN_ROOT}/scripts/cleanup-stale.sh" } ] }
    ]
  }
}
